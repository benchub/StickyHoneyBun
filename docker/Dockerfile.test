ARG PG_MAJOR=15
FROM postgres:${PG_MAJOR}

ARG PG_MAJOR
ENV DEBIAN_FRONTEND=noninteractive
ENV PG_CONFIG=/usr/lib/postgresql/${PG_MAJOR}/bin/pg_config

# Optional extra flags for sanitizer / hardening builds. Default empty
# preserves the standard build behavior; `make docker-test-ubsan-N` sets
# this to enable UBSAN.
ARG EXTRA_CFLAGS=""
ENV PG_CPPFLAGS="${EXTRA_CFLAGS}"
ENV COPT="${EXTRA_CFLAGS}"

# Which schema the tests install the extension into. Empty = default
# install (PG drops it in current_schema(), typically `public`).
# Any other value triggers the relocatable-install path via the
# SHB::install_extension helper (CREATE SCHEMA, CREATE EXTENSION WITH
# SCHEMA, ALTER DATABASE search_path). `make docker-test-matrix` runs
# the suite once per (PG version × {public, sticky_honey_bun}) pair so
# a regression that breaks either install layout is caught.
ARG SHB_INSTALL_SCHEMA=""
ENV SHB_INSTALL_SCHEMA="${SHB_INSTALL_SCHEMA}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        postgresql-server-dev-${PG_MAJOR} \
        libkrb5-dev \
        libipc-run-perl \
        libtest-simple-perl \
        libubsan1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src/

RUN make clean >/dev/null 2>&1 || true
RUN make local
RUN make install

# PG won't initdb/run as root; tests spin up their own ephemeral cluster.
RUN chown -R postgres:postgres /src
USER postgres
RUN make installcheck
